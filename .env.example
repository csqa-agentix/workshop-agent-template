# ─────────────────────────────────────────────────────────────────────────────
# .env – your secrets and settings. Copy this file to .env, then edit .env.
# NEVER commit .env, never paste its contents into a chat or an AI tool.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED for the real model (not needed for --offline). Get one free at https://build.nvidia.com
# (LLM_API_KEY or OPENAI_API_KEY are also accepted, so you can point this at another provider.)
NVIDIA_API_KEY=nvapi-paste-your-key-here

# ── Only if you use an external MCP server that needs a token (see docs/MCP.md) ──
# GITHUB_TOKEN=github_pat_...            # a READ-ONLY token, for the GitHub MCP server

# ── Optional: tune the model (the defaults are fine) ─────────────────────────────
# MODEL=nvidia/nemotron-3-super-120b-a12b
# BASE_URL=https://integrate.api.nvidia.com/v1
# THINKING=low                      # off | low | on – how much the model "thinks" before acting
# MAX_TURNS=15                      # hard stop for one run
# MIN_SECONDS_BETWEEN_CALLS=1.6     # free tier is about 40 requests per minute
# SKILLS_MODE=inline                # inline | on_demand (the agent loads skills with a tool)

# ── Optional: tracing (see docs/TRACING.md) ──────────────────────────────────────
# TRACE_CONTENT=on                  # off = do not keep the text of model messages in runs/
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318     # also send traces to Phoenix / Langfuse / Jaeger

# ── Optional: let OTHER programs call your agent over A2A (see README) ───────────
# A2A_TOKEN=choose-a-long-random-password   # callers must send  Authorization: Bearer <this>
# PUBLIC_URL=http://192.168.1.20:8000       # the address others will use (goes into the Agent Card)
# PUBLIC_HOSTS=192.168.1.20                 # extra host names the server accepts
